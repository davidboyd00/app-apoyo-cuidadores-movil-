# Backend caregivers (FastAPI)
# En dev suele ser http://localhost:8000; en el emulador Android usar
# http://10.0.2.2:8000; en el iPhone físico, la IP LAN de tu Mac.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase — proyecto compartido con el backend (mismo `db/schema.sql`).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Versión de la política de privacidad que espera el backend. Debe coincidir
# con `POLICY_VERSION` del `.env` del backend, si no todo cae en 409.
EXPO_PUBLIC_POLICY_VERSION=2026-09-11
